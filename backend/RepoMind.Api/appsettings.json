{
  "Ai": {
    "Provider": "ollama"
  },
  "Cloudflare": {
    "RerankingEnabled": false
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/",
    "EmbeddingModel": "embeddinggemma",
    "ChatModel": "qwen3:4b",
    "ChatTimeoutSeconds": 180
  },
  "RepositorySearch": {
    "MinimumSimilarity": 0.35
  },
  "RagContext": {
    "MaxCharacters": 10000
  },
  "HybridSearch": {
    "VectorCandidates": 15,
    "LexicalCandidates": 15
  },
  "Reranking": {
    "Enabled": false,
    "MaxCandidates": 4,
    "PromptMaxCharacters": 12000,
    "TimeoutSeconds": 120
  },
  "EvidenceVerification": {
    "MaxCharacters": 8000,
    "TimeoutSeconds": 120
  },
  "RagAnswer": {
    "TimeoutSeconds": 90
  },
  "RagGeneration": {
    "ContextWindowTokens": 4096,
    "MaxOutputTokens": 512,
    "ReservedTokens": 512,
    "MaximumEvidenceChunks": 5
  },
  "Agents": {
    "TimeoutSeconds": 420,
    "ModelTimeoutSeconds": 240,
    "PlannerTimeoutSeconds": 60,
    "ModelPlanning": true,
    "MaxToolCalls": 10,
    "MaxEvidenceCharacters": 6000,
    "MaxLinesPerFile": 150,
    "ContextWindowTokens": 6144,
    "MaxOutputTokens": 1000
  },
  "ConnectionStrings": {
    "RepoMind": "Host=localhost;Port=5432;Database=repomind;Username=repomind;Password=localdev"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
