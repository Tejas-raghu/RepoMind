{
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
